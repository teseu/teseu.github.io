---

const { classLink, link, caption  } = Astro.props
---

  <a href={link} class:list={["group link rounded-lg bg-gray-100 shadow-lg", classLink ]} >
    <slot name="img" /> 
    <div class="relative w-full bg-gradient-to-t from-neutral-950/90 via-neutral-950/50 to-neutral-950/0 md:pl-5 md:text-2xl pl-4 pb-3 pt-12 text-lg text-white">{caption}</div>
  </a>

  <style>
    
    .link {
        @apply relative flex items-end overflow-hidden;
    }
    .img {
        @apply absolute h-full w-full object-cover transition duration-200 saturate-50 hover:saturate-100 hover:scale-110;
    }
    
    .img-div {
        @apply pointer-events-none absolute bg-gradient-to-t via-transparent to-transparent opacity-50;
    }
    
    </style>
